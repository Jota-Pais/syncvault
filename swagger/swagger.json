{
    "swagger": "2.0",
    "info": {
        "description": "Estoque único para uma loja que vende no balcão, no Mercado Livre e na Shopee: toda venda, de qualquer canal, desconta do mesmo estoque. Dinheiro sempre em centavos (R$ 109,90 = 10990).",
        "title": "SyncVault API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/canais": {
            "get": {
                "description": "Lista os canais de venda, com a taxa e o estoque de segurança de cada um. É daqui que sai o canalId de uma venda.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "canais"
                ],
                "summary": "Lista os canais",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/dto.CanalResponseDTO"
                            }
                        }
                    }
                }
            }
        },
        "/produtos": {
            "get": {
                "description": "Lista todos os produtos, com o estoque atual. Sem produto, devolve lista vazia.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "produtos"
                ],
                "summary": "Lista os produtos",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/dto.ProdutoResponseDTO"
                            }
                        }
                    }
                }
            },
            "post": {
                "description": "Cadastra um produto com o estoque inicial. O estoque é um só para todos os canais.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "produtos"
                ],
                "summary": "Cadastra um produto",
                "parameters": [
                    {
                        "description": "Produto a cadastrar",
                        "name": "produto",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.ProdutoRequestDTO"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/dto.ProdutoResponseDTO"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/dto.ErroDTO"
                        }
                    }
                }
            }
        },
        "/produtos/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "produtos"
                ],
                "summary": "Busca um produto",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Id do produto",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.ProdutoResponseDTO"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/dto.ErroDTO"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/dto.ErroDTO"
                        }
                    }
                }
            }
        },
        "/vendas": {
            "post": {
                "description": "Registra uma venda de qualquer canal e desconta do estoque único. As regras são conferidas nesta ordem: R2 (o preço, descontada a taxa do canal, não fica abaixo do custo), R1 (a quantidade não passa do estoque) e R3 (a venda não deixa o estoque abaixo do estoque de segurança do canal). Regra violada devolve 400, com a regra na mensagem.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "vendas"
                ],
                "summary": "Registra uma venda",
                "parameters": [
                    {
                        "description": "Venda a registrar",
                        "name": "venda",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.VendaRequestDTO"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/dto.VendaResponseDTO"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/dto.ErroDTO"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/dto.ErroDTO"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.CampoErroDTO": {
            "type": "object",
            "properties": {
                "campo": {
                    "type": "string",
                    "example": "nome"
                },
                "mensagem": {
                    "type": "string",
                    "example": "nome é obrigatório"
                }
            }
        },
        "dto.CanalResponseDTO": {
            "type": "object",
            "properties": {
                "estoqueSeguranca": {
                    "description": "Quantas unidades este canal não pode vender (R3).",
                    "type": "integer",
                    "example": 2
                },
                "id": {
                    "type": "integer",
                    "example": 2
                },
                "nome": {
                    "type": "string",
                    "example": "Mercado Livre"
                },
                "taxaPercentual": {
                    "description": "A comissão que o canal fica de cada venda, em percentual inteiro (16 = 16%).",
                    "type": "integer",
                    "example": 16
                }
            }
        },
        "dto.ErroDTO": {
            "type": "object",
            "properties": {
                "caminho": {
                    "type": "string",
                    "example": "/produtos/999"
                },
                "campos": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.CampoErroDTO"
                    }
                },
                "erro": {
                    "type": "string",
                    "example": "Not Found"
                },
                "mensagem": {
                    "type": "string",
                    "example": "Produto não encontrado: 999"
                },
                "status": {
                    "type": "integer",
                    "example": 404
                },
                "timestamp": {
                    "type": "string",
                    "example": "2026-10-20T19:30:00-03:00"
                }
            }
        },
        "dto.ProdutoRequestDTO": {
            "type": "object",
            "required": [
                "custoCentavos",
                "estoque",
                "nome"
            ],
            "properties": {
                "custoCentavos": {
                    "description": "Quanto a loja pagou por uma unidade, em centavos (R$ 60,00 = 6000).",
                    "type": "integer",
                    "example": 6000
                },
                "estoque": {
                    "description": "Ponteiro para separar \"não veio\" (nil) de \"veio zero\": estoque 0 é válido.",
                    "type": "integer",
                    "minimum": 0,
                    "example": 5
                },
                "nome": {
                    "type": "string",
                    "maxLength": 255,
                    "example": "Casaco corta-vento"
                }
            }
        },
        "dto.ProdutoResponseDTO": {
            "type": "object",
            "properties": {
                "custoCentavos": {
                    "type": "integer",
                    "example": 6000
                },
                "estoque": {
                    "description": "O estoque único: o mesmo para todos os canais.",
                    "type": "integer",
                    "example": 5
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "nome": {
                    "type": "string",
                    "example": "Casaco corta-vento"
                }
            }
        },
        "dto.VendaRequestDTO": {
            "type": "object",
            "required": [
                "canalId",
                "precoUnitarioCentavos",
                "produtoId",
                "quantidade"
            ],
            "properties": {
                "canalId": {
                    "type": "integer",
                    "example": 2
                },
                "precoUnitarioCentavos": {
                    "description": "O preço praticado neste canal, por unidade, em centavos (R$ 109,90 = 10990).",
                    "type": "integer",
                    "example": 10990
                },
                "produtoId": {
                    "type": "integer",
                    "example": 1
                },
                "quantidade": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "dto.VendaResponseDTO": {
            "type": "object",
            "properties": {
                "canal": {
                    "$ref": "#/definitions/dto.CanalResponseDTO"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "precoUnitarioCentavos": {
                    "type": "integer",
                    "example": 10990
                },
                "produto": {
                    "$ref": "#/definitions/dto.ProdutoResponseDTO"
                },
                "quantidade": {
                    "type": "integer",
                    "example": 1
                },
                "recebidoCentavos": {
                    "description": "Quanto a loja recebe depois da comissão do canal. Quem calcula é o Service.",
                    "type": "integer",
                    "example": 9231
                },
                "vendidaEm": {
                    "type": "string",
                    "example": "2026-10-20T19:30:00-03:00"
                }
            }
        }
    }
}